{
  "name": "@local/dh-extensions",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "DSH extensions: one Settings section collecting global AGENTS.md editing, completion notifications, sandbox repair, bulk workspace-session archiving, a forked side conversation, and a compatibility self-check",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lllcccwww/dsh-extensions.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "features/**/*",
    "shared/**/*",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}

